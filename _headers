# Security headers for Cloudflare Pages (other hosts: copy these into your server config).
# TEST the site after enabling — if you add a new third-party script/API, add its host below.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: microphone=(self), camera=(), geolocation=(), payment=(self)
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://checkout.razorpay.com https://*.razorpay.com; style-src 'self' 'unsafe-inline' https://*.razorpay.com; font-src 'self' data: https://*.razorpay.com; img-src 'self' data: blob: https://*.razorpay.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.groq.com https://generativelanguage.googleapis.com https://api.openai.com https://api.razorpay.com https://*.razorpay.com; frame-src 'self' https://api.razorpay.com https://*.razorpay.com https://checkout.razorpay.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self' https://*.razorpay.com; frame-ancestors 'none'

/.well-known/assetlinks.json
  Content-Type: application/json
  Access-Control-Allow-Origin: *

/sw.js
  Cache-Control: no-cache
